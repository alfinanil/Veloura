APP_NAME="Veloura API"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# SQLite (default, tanpa instalasi). Ganti path jika perlu.
DB_PATH=database/veloura.sqlite

# Wajib diganti di production: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
JWT_TTL_MINUTES=120

# Pisahkan dengan koma. Isi domain frontend production (mis. https://veloura.vercel.app)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5501,http://localhost:5501,http://127.0.0.1:5500,http://localhost:5173
